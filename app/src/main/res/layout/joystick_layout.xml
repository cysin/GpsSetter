<?xml version="1.0" encoding="utf-8"?>
<!--
    wrap_content on the root, not match_parent: the window itself is
    WRAP_CONTENT, so a match_parent root expanded the overlay to the full screen
    and swallowed touches everywhere outside the joystick.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/joystick_readout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="#B0000000"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <io.github.controlwear.virtual.joystick.android.JoystickView
        android:id="@+id/joystickView_right"
        android:layout_width="120dp"
        android:layout_height="120dp"
        custom:JV_backgroundColor="#7F009688"
        custom:JV_borderColor="#00796B"
        custom:JV_borderWidth="6dp"
        custom:JV_buttonColor="#FF6E40" />

</LinearLayout>
