<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Recommended scope, shown by the Xposed manager. Deliberately empty: every
        hook in this module runs inside the *target app's* process (loadApp), so
        recommending "android" would install client-side hooks into system_server.
        The user picks the apps to spoof.
    -->
    <string-array name="scopes" />

    <!-- DarkTheme Preference -->

    <string-array name="theme_texts" translatable="false">
        <item>Always off</item>
        <item>Always on</item>
        <item>Follow system</item>
    </string-array>

    <string-array name="theme_values" translatable="false">
        <item>1</item>
        <item>2</item>
        <item>-1</item>
    </string-array>



    <!-- Jitter movement style; values must match JitterEngine.Mode -->
    <string-array name="jitter_mode_texts">
        <item>Stationary</item>
        <item>Walking</item>
        <item>Driving</item>
    </string-array>

    <string-array name="jitter_mode_values" translatable="false">
        <item>STATIONARY</item>
        <item>WALKING</item>
        <item>DRIVING</item>
    </string-array>


    <!-- OpenFreeMap style names; values must match MapEngine -->
    <string-array name="map_style_texts">
        <item>Liberty</item>
        <item>Bright</item>
        <item>Positron</item>
    </string-array>

    <string-array name="map_style_values" translatable="false">
        <item>liberty</item>
        <item>bright</item>
        <item>positron</item>
    </string-array>

</resources>