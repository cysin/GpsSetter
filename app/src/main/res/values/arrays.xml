<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Recommended scope, shown by the Xposed manager. Deliberately empty: every
        hook in this module runs inside the *target app's* process (loadApp), so
        recommending "android" would install client-side hooks into system_server.
        The user picks the apps to spoof.
    -->
    <string-array name="scopes" />

    <!-- DarkTheme Preference -->

    <string-array name="theme_texts" translatable="false">
        <item>Always off</item>
        <item>Always on</item>
        <item>Follow system</item>
    </string-array>

    <string-array name="theme_values" translatable="false">
        <item>1</item>
        <item>2</item>
        <item>-1</item>
    </string-array>


</resources>